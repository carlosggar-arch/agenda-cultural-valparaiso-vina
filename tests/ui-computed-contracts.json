{
  "schema_version": "1.0.0",
  "contexts": {
    "desktop": {"city": "valparaiso", "viewport": [1280, 900]},
    "mobile": {"city": "valparaiso", "viewport": [390, 844]}
  },
  "contracts": [
    {
      "id": "map-control-visible-box",
      "selector": ".map-location-link",
      "contexts": ["desktop", "mobile"],
      "min_count": 1,
      "sample_limit": 8,
      "computed": {
        "width": "25px",
        "height": "25px",
        "minWidth": "25px",
        "minHeight": "25px",
        "maxWidth": "25px",
        "maxHeight": "25px"
      },
      "rect": {"width": 25, "height": 25, "tolerance": 0.05}
    },
    {
      "id": "map-control-touch-target",
      "selector": ".map-location-link",
      "pseudo": "::before",
      "contexts": ["desktop", "mobile"],
      "min_count": 1,
      "sample_limit": 8,
      "computed": {"width": "44px", "height": "44px"}
    }
  ]
}
